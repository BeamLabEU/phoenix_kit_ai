<div class="flex flex-col w-full px-4 py-6">
    <%!-- Inner form capped at 7xl: wider response/messages area on large
         monitors, but single-line inputs don't stretch absurdly on
         ultrawide displays. --%>
    <div class="max-w-7xl mx-auto space-y-6 w-full">
      <form id="ai-playground-form" phx-change="change" phx-submit="send" class="space-y-6">
        <.form_section title={gettext("Configuration")} icon="hero-cog-6-tooth" class="bg-base-200">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-2">
            <%!-- Endpoint Selector --%>
            <div>
              <.select
                name="endpoint_uuid"
                label={gettext("Endpoint") <> " *"}
                prompt={gettext("Select an endpoint...")}
                value={@selected_endpoint_uuid}
                options={
                  Enum.map(@endpoints, fn endpoint ->
                    {"#{endpoint.name} (#{PhoenixKitAI.Endpoint.short_model_name(endpoint.model)})",
                     endpoint.uuid}
                  end)
                }
              />
              <%= if Enum.empty?(@endpoints) do %>
                <p class="text-sm text-warning mt-1">
                  {gettext("No enabled endpoints.")}
                  <.pk_link navigate="/admin/ai/endpoints/new" class="link link-primary">
                    {gettext("Create one")}
                  </.pk_link>
                </p>
              <% end %>
            </div>

            <%!-- Prompt Selector --%>
            <.select
              name="prompt_uuid"
              label={gettext("Prompt (Optional)")}
              prompt={gettext("Freeform (no prompt template)")}
              value={@selected_prompt_uuid}
              options={Enum.map(@prompts, fn prompt -> {prompt.name, prompt.uuid} end)}
            />
          </div>
        </.form_section>

        <.form_section
          title={if @selected_prompt, do: @selected_prompt.name, else: gettext("Message")}
          icon={if @selected_prompt, do: "hero-document-text", else: "hero-chat-bubble-left-right"}
          class="bg-base-200"
        >
          <%= if @selected_prompt do %>
            <%!-- Prompt Mode --%>
            <%= if @selected_prompt.description do %>
              <p class="text-sm text-base-content/60">{@selected_prompt.description}</p>
            <% end %>

            <%!-- System Prompt Preview --%>
            <%= if @selected_prompt.system_prompt && @selected_prompt.system_prompt != "" do %>
              <div class="mt-2">
                <label class="block text-xs font-medium text-base-content/60 mb-1">
                  {gettext("System Prompt")}
                </label>
                <div class="bg-base-300 rounded-lg p-3 text-sm font-mono whitespace-pre-wrap text-base-content/80">
                  {@selected_prompt.system_prompt}
                </div>
              </div>
            <% end %>

            <%!-- Editable Content --%>
            <div class="mt-2" id={"edited-content-wrap-#{@selected_prompt.uuid}"} phx-update="ignore">
              <.textarea
                name="edited_content"
                label={gettext("Prompt Template (editable)")}
                value={@edited_content || @selected_prompt.content}
                class="font-mono text-sm"
                rows={
                  max(
                    5,
                    length(String.split(@edited_content || @selected_prompt.content, "\n")) + 2
                  )
                }
                phx-debounce="300"
              />
            </div>

            <%!-- Variable Inputs --%>
            <%= if length(@edited_variables) > 0 do %>
              <div class="divider text-sm">{gettext("Variables")}</div>
              <div class="space-y-3">
                <%= for var <- @edited_variables do %>
                  <div>
                    <label class="block text-sm font-medium mb-1">
                      <span class="font-mono badge badge-primary badge-outline badge-sm mr-1">
                        {"{{#{var}}}"}
                      </span>
                    </label>
                    <.textarea
                      name={"variables[#{var}]"}
                      value={Map.get(@variable_values, var, "")}
                      class="text-sm"
                      rows="2"
                      placeholder={gettext("Enter value for %{name}...", name: var)}
                      phx-debounce="300"
                    />
                  </div>
                <% end %>
              </div>
            <% end %>
          <% else %>
            <%!-- Freeform Mode --%>
            <.textarea
              name="system"
              label={gettext("System Prompt (Optional)")}
              value={@freeform_system}
              class="text-sm"
              rows="2"
              placeholder={gettext("Optional system instructions...")}
              phx-debounce="300"
            />

            <.textarea
              id="playground-message"
              name="message"
              label={gettext("Message") <> " *"}
              value={@freeform_message}
              class="text-sm"
              rows="4"
              placeholder={gettext("Type your message to the AI...")}
              phx-debounce="300"
            />

            <%!-- The component a host page embeds: the words go into the
                 message where the cursor was, as if typed. It writes down
                 with the Speech to text card's settings. --%>
            <.live_component
              :if={@selected_endpoint && @recorder_available}
              module={PhoenixKitAI.Web.Components.Dictate}
              id="playground-dictate"
              endpoint={@selected_endpoint}
              into="playground-message"
              mode={:at_cursor}
              label={gettext("Dictate")}
              busy={@sending}
              {@dictate_opts}
            />
          <% end %>

          <%!-- Actions --%>
          <div class="flex justify-end gap-2 mt-4">
            <.button type="button" variant="ghost" size="sm" phx-click="clear" disabled={@sending}>
              {gettext("Clear")}
            </.button>
            <.button
              type="submit"
              phx-disable-with={gettext("Sending…")}
              disabled={@sending || is_nil(@selected_endpoint_uuid)}
            >
              <%= if @sending do %>
                <span class="loading loading-spinner loading-sm"></span> {gettext("Sending…")}
              <% else %>
                <.icon name="hero-paper-airplane" class="w-4 h-4 mr-1" /> {gettext("Send")}
              <% end %>
            </.button>
          </div>
        </.form_section>
      </form>

      <%!-- Streaming Voice (xAI Realtime) — only for endpoints whose
           provider declares the :realtime_voice capability. --%>
      <%= if @selected_endpoint && PhoenixKitAI.Endpoint.realtime_voice_capable?(@selected_endpoint.provider) do %>
        <.form_section
          title={gettext("Streaming Voice (xAI)")}
          icon="hero-speaker-wave"
          class="bg-base-200"
        >
          <form id="ai-playground-voice-form" phx-change="voice_change" phx-submit="speak_voice" class="space-y-3">
            <.select
              name="voice"
              label={gettext("Voice")}
              value={@voice_selected}
              options={@voice_options}
              disabled={@voice_status == :connected}
            />

            <.textarea
              name="text"
              value={@voice_text}
              rows="3"
              placeholder={gettext("Type text to speak...")}
              phx-debounce="300"
              disabled={@voice_status != :connected}
            />

            <%= if @voice_error do %>
              <p class="text-sm text-error">{@voice_error}</p>
            <% end %>

            <div class="flex justify-between items-center">
              <span class="text-sm text-base-content/60">
                <%= case @voice_status do %>
                  <% :idle -> %>
                    {gettext("Not connected")}
                  <% :connecting -> %>
                    {gettext("Connecting…")}
                  <% :connected -> %>
                    <.icon name="hero-signal" class="w-4 h-4 inline text-success" />
                    {gettext("Connected")}
                  <% :error -> %>
                    {gettext("Disconnected")}
                <% end %>
              </span>

              <div class="flex gap-2">
                <.button
                  type="button"
                  size="sm"
                  variant="neutral"
                  phx-click="start_voice"
                  phx-disable-with={gettext("Connecting…")}
                  disabled={@voice_status == :connected}
                >
                  {gettext("Connect")}
                </.button>
                <.button
                  type="button"
                  size="sm"
                  variant="ghost"
                  phx-click="stop_voice"
                  disabled={@voice_status != :connected}
                >
                  {gettext("Disconnect")}
                </.button>
                <.button
                  type="submit"
                  size="sm"
                  phx-disable-with={gettext("Speaking…")}
                  disabled={@voice_status != :connected || @voice_text == ""}
                >
                  <.icon name="hero-speaker-wave" class="w-4 h-4 mr-1" /> {gettext("Speak")}
                </.button>
              </div>
            </div>
          </form>

          <div id="xai-voice-stream" phx-hook="XaiVoiceStream" phx-update="ignore"></div>
        </.form_section>
      <% end %>

      <%!-- Image edit: PhoenixKitAI.process_image/4 + describe_image/3 —
           one or two images, named operations and/or an instruction,
           options fitted to the model. Separate form: uploads need
           phx-change on the form holding the file input. --%>
      <%= if @selected_endpoint do %>
        <.form_section
          title={gettext("Image edit")}
          icon="hero-photo"
          class="bg-base-200"
          id="playground-image-edit"
        >
          <p class="text-sm text-base-content/70">
            {gettext(
              "Send one or more images to an image-capable endpoint. The first image is the one being edited; the rest are references. Pick operations, add an instruction, or both — they become one prompt, and options are fitted to what the model accepts."
            )}
          </p>
          <form id="playground-image-edit-form" phx-change="edit_change" phx-submit="edit_send" class="space-y-3">
            <%!-- Not core's <.file_upload>: its "button" variant always wraps the
                 input in its own <form> (nesting splits this form in two), and
                 its stats hook reads "Processing on server…" for any finished
                 entry that is not consumed yet — here entries wait for Send. --%>
            <label class="btn btn-outline btn-sm focus-within:ring-2 focus-within:ring-primary">
              <.icon name="hero-photo" class="w-4 h-4" />
              {gettext("Add image")}
              <.live_file_input upload={@uploads.edit_images} class="sr-only" />
            </label>
            <p :for={err <- upload_errors(@uploads.edit_images)} class="text-xs text-error" role="alert">
              {PhoenixKitAI.Web.Playground.upload_error_message(err)}
            </p>
            <p :if={@edit_inputs != [] and @uploads.edit_images.entries == []} class="text-xs text-base-content/60">
              {ngettext("%{count} image kept from the last run", "%{count} images kept from the last run", length(@edit_inputs), count: length(@edit_inputs))}
              ·
              <button type="button" class="link" phx-click="edit_clear_inputs">{gettext("Clear")}</button>
            </p>
            <div :if={@uploads.edit_images.entries != []} class="flex flex-wrap gap-3">
              <div :for={entry <- @uploads.edit_images.entries} class="relative w-32">
                <.live_img_preview entry={entry} alt={gettext("Uploaded image")} class="w-32 h-24 object-cover rounded bg-base-300" />
                <progress
                  :if={!entry.done?}
                  class="progress progress-primary w-full mt-1"
                  value={entry.progress}
                  max="100"
                />
                <button
                  type="button"
                  class="btn btn-xs btn-circle absolute -top-2 -right-2"
                  phx-click="edit_remove"
                  phx-value-ref={entry.ref}
                  aria-label={gettext("Remove")}
                >
                  <.icon name="hero-x-mark" class="w-3 h-3" />
                </button>
                <p :for={err <- upload_errors(@uploads.edit_images, entry)} class="text-xs text-error mt-1">
                  {PhoenixKitAI.Web.Playground.upload_error_message(err)}
                </p>
              </div>
            </div>

            <div>
              <span class="label-text text-sm">{gettext("Operations")}</span>
              <div class="flex flex-wrap gap-2 mt-1" role="group" aria-label={gettext("Operations")}>
                <label
                  :for={{name, _spec} <- PhoenixKitAI.image_operations() |> Enum.reject(fn {n, _} -> n == :instruction end) |> Enum.sort_by(fn {n, _} -> Atom.to_string(n) end)}
                  class={[
                    "btn btn-xs rounded-full normal-case",
                    if(Atom.to_string(name) in @edit_operations, do: "btn-primary", else: "btn-ghost bg-base-100")
                  ]}
                  title={PhoenixKitAI.Images.Operations.label(name)}
                >
                  <input
                    type="checkbox"
                    name="ops[]"
                    value={Atom.to_string(name)}
                    checked={Atom.to_string(name) in @edit_operations}
                    class="sr-only"
                  />
                  {PhoenixKitAI.Images.Operations.label(name)}
                </label>
              </div>
            </div>

            <.textarea
              id="playground-edit-prompt"
              name="edit_prompt"
              label={gettext("Instruction (optional with operations; the question for Describe)")}
              value={@edit_prompt}
              rows="3"
              placeholder={gettext("e.g. Repaint the cabinet fronts in matte sage green; keep everything else as it is")}
              phx-debounce="300"
            />

            <div class="flex flex-wrap items-end gap-3">
              <div :if={@image_models == []} class="flex items-center gap-2">
                <.button
                  type="button"
                  variant="ghost"
                  size="sm"
                  phx-click="load_image_models"
                  disabled={@image_models_loading}
                  phx-disable-with={gettext("Loading…")}
                >
                  <.icon name="hero-list-bullet" class="w-4 h-4" /> {gettext("Load model list")}
                </.button>
                <span :if={@image_models_loading} class="loading loading-spinner loading-xs" aria-hidden="true"></span>
                <span :if={@image_models_error} class="text-xs text-base-content/60">{@image_models_error}</span>
              </div>
              <.select
                :if={@image_models != []}
                name="edit_model"
                label={gettext("Model (override)")}
                value={@edit_model}
                options={[{gettext("Endpoint's model"), ""} | Enum.map(@image_models, &{&1.name || &1.id, &1.id})]}
              />
              <.select
                :for={key <- ~w(aspect_ratio resolution quality background output_format)a}
                :if={PhoenixKitAI.Images.ImageModel.values(@edit_capabilities, key) != []}
                name={"opt[#{key}]"}
                label={PhoenixKitAI.Web.Playground.option_label(key)}
                value={Map.get(@edit_options, Atom.to_string(key), "")}
                options={[{"—", ""} | Enum.map(PhoenixKitAI.Images.ImageModel.values(@edit_capabilities, key), &{&1, &1})]}
              />
            </div>

            <.checkbox
              name="verify"
              checked={@edit_verify}
              class="checkbox-sm"
              label={gettext("Check the result against the original with the same endpoint (one more call)")}
            />

            <p :if={@edit_error} class="text-sm text-error" role="alert">{@edit_error}</p>
            <div class="flex flex-wrap items-center gap-3">
              <.button type="submit" disabled={@editing || @describing} phx-disable-with={gettext("Editing…")}>
                <.icon name="hero-sparkles" class="w-4 h-4" />
                {gettext("Edit image")}
              </.button>
              <.button
                type="submit"
                name="action"
                value="describe"
                variant="outline"
                disabled={@editing || @describing}
                phx-disable-with={gettext("Asking…")}
              >
                <.icon name="hero-eye" class="w-4 h-4" />
                {gettext("Describe")}
              </.button>
              <span :if={@editing || @describing} class="loading loading-spinner loading-sm text-primary" aria-hidden="true"></span>
              <span :if={@editing || @describing} class="text-sm text-base-content/60">{gettext("Usually 10–40 seconds…")}</span>
            </div>
          </form>

          <div :if={@describe_result} class="space-y-1 pt-2">
            <div class="text-xs text-base-content/60">{gettext("Describe")} · {@describe_result.model}</div>
            <p class="text-sm whitespace-pre-wrap bg-base-300 rounded-lg p-3">{@describe_result.text}</p>
          </div>

          <div :if={@edit_result} class="space-y-2 pt-2">
            <div class="flex flex-wrap gap-3 text-xs text-base-content/60">
              <span :if={@edit_result.model}>
                <.icon name="hero-cpu-chip" class="w-3 h-3 inline" /> {@edit_result.model}
              </span>
            </div>
            <p :for={warning <- @edit_result.warnings} class="text-xs text-warning">
              {PhoenixKitAI.Web.Playground.warning_message(warning)}
            </p>
            <a :if={@edit_result.src} href={@edit_result.src} target="_blank" rel="noopener" class="block max-w-xl">
              <img src={@edit_result.src} alt={gettext("Edited image")} class="rounded-lg w-full" />
            </a>
            <div :if={@edit_result.verification} class="text-sm">
              <span class={["badge badge-sm", if(@edit_result.verification[:passed], do: "badge-success", else: "badge-warning")]}>
                {if @edit_result.verification[:passed], do: gettext("Check passed"), else: gettext("The check found changes")}
              </span>
              <span class="ml-2">{@edit_result.verification[:summary]}</span>
              <ul :if={@edit_result.verification[:unwanted_changes] not in [nil, []]} class="list-disc ml-6 text-base-content/70">
                <li :for={change <- @edit_result.verification[:unwanted_changes]}>{change}</li>
              </ul>
              <span :if={@edit_result.verification[:error]} class="text-error">
                {PhoenixKitAI.Errors.message(@edit_result.verification[:error])}
              </span>
            </div>
            <p :if={@edit_result.text && @edit_result.text != ""} class="text-sm whitespace-pre-wrap">
              {@edit_result.text}
            </p>
            <details :if={@edit_result.prompt} class="text-xs" phx-mounted={Phoenix.LiveView.JS.ignore_attributes(["open"])}>
              <summary class="cursor-pointer text-base-content/60">{gettext("Prompt sent")}</summary>
              <pre class="whitespace-pre-wrap font-[inherit] mt-1 bg-base-300 rounded p-2">{@edit_result.prompt}</pre>
            </details>
          </div>
        </.form_section>
      <% end %>

      <%!-- Speech to text: PhoenixKitAI.transcribe/3. One clip, recorded
           here or picked as a file, kept so it can be run again with other
           settings; the last answers are listed to compare. Its own form:
           the file input needs phx-change on the form that holds it. --%>
      <%= if @selected_endpoint do %>
        <.form_section
          title={gettext("Speech to text")}
          icon="hero-microphone"
          class="bg-base-200"
          id="playground-transcribe"
        >
          <p class="text-sm text-base-content/70">
            {gettext(
              "Record or pick a recording and see what the endpoint writes down. The clip is kept: run it again with another model, language, path or instructions and compare the answers. The Dictate button under the chat message uses these settings too."
            )}
          </p>
          <form id="playground-transcribe-form" phx-change="stt_change" phx-submit="stt_send" class="space-y-3">
            <div class="flex flex-wrap items-center gap-3">
              <PhoenixKitAI.Web.Components.Dictate.recorder
                id="playground-stt-recorder"
                format={:wav_16k}
                max_seconds={300}
                label={gettext("Record")}
                busy={@stt_running}
                errors={:inline}
                target={nil}
              />
              <label class="btn btn-outline btn-sm focus-within:ring-2 focus-within:ring-primary">
                <.icon name="hero-arrow-up-tray" class="w-4 h-4" />
                {gettext("Pick a file")}
                <.live_file_input upload={@uploads.stt_file} class="sr-only" />
              </label>
            </div>
            <p :if={!@recorder_available} class="text-xs text-base-content/60">
              {gettext("Recording here needs PhoenixKit 3.4 or later. Pick a file instead.")}
            </p>
            <p :for={err <- upload_errors(@uploads.stt_file)} class="text-xs text-error" role="alert">
              {PhoenixKitAI.Web.Playground.upload_error_label(err)}
            </p>
            <div :for={entry <- @uploads.stt_file.entries} class="flex items-center gap-2 text-xs">
              <span class="truncate max-w-xs">{entry.client_name}</span>
              <progress class="progress progress-primary w-32" value={entry.progress} max="100" />
              <button type="button" class="link" phx-click="stt_remove_upload" phx-value-ref={entry.ref}>
                {gettext("Cancel")}
              </button>
              <span :for={err <- upload_errors(@uploads.stt_file, entry)} class="text-error">
                {PhoenixKitAI.Web.Playground.upload_error_label(err)}
              </span>
            </div>

            <div :if={@stt_audio} id="playground-stt-clip" class="rounded-lg bg-base-100 p-3 space-y-2">
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-base-content/70">
                <.icon name="hero-musical-note" class="w-4 h-4" />
                <span class="font-medium text-base-content">{@stt_audio.name}</span>
                <span class="uppercase">{@stt_audio.format}</span>
                <span>{PhoenixKitAI.Web.Playground.format_bytes(@stt_audio.bytes)}</span>
                <span :if={@stt_audio.seconds}>{PhoenixKitAI.Web.Playground.format_seconds(@stt_audio.seconds)}</span>
                <button type="button" class="link ml-auto" phx-click="stt_clear_audio">{gettext("Remove")}</button>
              </div>
              <audio :if={@stt_audio_src} controls preload="metadata" src={@stt_audio_src} class="w-full max-w-md" />
              <p :if={!@stt_audio_src} class="text-xs text-base-content/60">
                {gettext("Too large to play back here.")}
              </p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
              <div>
                <.input
                  id="playground-stt-model"
                  name="stt_model"
                  label={gettext("Model (override)")}
                  value={@stt_model}
                  list="playground-stt-models"
                  autocomplete="off"
                  placeholder={@selected_endpoint.model}
                  phx-debounce="300"
                />
                <datalist id="playground-stt-models">
                  <option :for={{id, name} <- @stt_models} value={id}>{name}</option>
                </datalist>
              </div>
              <.input
                id="playground-stt-language"
                name="stt_language"
                label={gettext("Language (optional)")}
                value={@stt_language}
                placeholder={gettext("e.g. et, en, ru")}
                phx-debounce="300"
              />
              <.select
                id="playground-stt-transport"
                name="stt_transport"
                label={gettext("Path")}
                value={@stt_transport}
                options={[
                  {PhoenixKitAI.Web.Playground.auto_transport_label(@stt_hint), ""},
                  {PhoenixKitAI.Web.Playground.transport_label(:chat), "chat"},
                  {PhoenixKitAI.Web.Playground.transport_label(:transcriptions), "transcriptions"}
                ]}
              />
            </div>
            <p :if={@stt_models != []} class="text-xs text-base-content/60 -mt-1">
              {ngettext(
                "%{count} model at this provider is known to take audio: start typing in Model to pick it.",
                "%{count} models at this provider are known to take audio: start typing in Model to pick one.",
                length(@stt_models),
                count: length(@stt_models)
              )}
            </p>

            <.textarea
              id="playground-stt-instructions"
              name="stt_instructions"
              label={gettext("Instructions (optional)")}
              value={@stt_instructions}
              rows="2"
              placeholder={gettext("e.g. A customer ordering plywood. Write sizes as 2500×1250 and thicknesses as 18 mm.")}
              phx-debounce="300"
            />

            <p :if={@stt_hint} id="playground-stt-hint" class={["text-xs", PhoenixKitAI.Web.Playground.stt_hint_class(@stt_hint)]}>
              {PhoenixKitAI.Web.Playground.stt_hint_text(@stt_hint)}
            </p>
            <p :if={@stt_error} class="text-sm text-error" role="alert">{@stt_error}</p>

            <div class="flex flex-wrap items-center gap-3">
              <.button type="submit" disabled={@stt_running || is_nil(@stt_audio)} phx-disable-with={gettext("Writing down…")}>
                <.icon name="hero-document-text" class="w-4 h-4" />
                {if @stt_results == [], do: gettext("Write it down"), else: gettext("Write it down again")}
              </.button>
              <span :if={@stt_running} class="loading loading-spinner loading-sm text-primary" aria-hidden="true"></span>
              <span :if={@stt_running} class="text-sm text-base-content/60">{gettext("Writing down what was said…")}</span>
            </div>
          </form>

          <div :if={@stt_results != []} id="playground-stt-results" class="space-y-3 pt-2">
            <div class="flex items-center justify-between">
              <span class="text-xs font-medium text-base-content/60">
                {gettext("Answers, newest first")}
              </span>
              <button type="button" class="link text-xs" phx-click="stt_clear_results">{gettext("Clear")}</button>
            </div>
            <div :for={result <- @stt_results} id={"playground-stt-result-#{result.id}"} class="rounded-lg bg-base-100 p-3 space-y-2">
              <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs text-base-content/60">
                <span><.icon name="hero-cpu-chip" class="w-3 h-3 inline" /> {result.model}</span>
                <span>{result.endpoint_name}</span>
                <span>{PhoenixKitAI.Web.Playground.transport_label(result.transport)}</span>
                <span :if={result.language} class="badge badge-sm badge-outline">{result.language}</span>
                <span :if={result.duration}>
                  <.icon name="hero-musical-note" class="w-3 h-3 inline" /> {PhoenixKitAI.Web.Playground.format_seconds(result.duration)}
                </span>
                <span><.icon name="hero-clock" class="w-3 h-3 inline" /> {PhoenixKitAI.Web.Playground.format_seconds(result.elapsed_ms / 1000)}</span>
                <span :if={result.cost}>
                  <.icon name="hero-currency-dollar" class="w-3 h-3 inline" /> {PhoenixKitAI.Request.format_cost(result.cost)}
                </span>
                <span :if={result.language_hint}>{gettext("Language hint: %{language}", language: result.language_hint)}</span>
                <span :if={result.instructions?}>{gettext("With instructions")}</span>
              </div>
              <p :if={result.text != ""} id={"playground-stt-text-#{result.id}"} class="text-sm whitespace-pre-wrap">{result.text}</p>
              <p :if={result.text == ""} class="text-sm text-base-content/60 italic">
                {gettext("No speech was heard in the recording.")}
              </p>
              <div :if={result.text != ""} class="flex gap-3 text-xs">
                <button
                  type="button"
                  id={"playground-stt-copy-#{result.id}"}
                  class="link"
                  phx-hook="CopyToClipboard"
                  data-copy-target={"#playground-stt-text-#{result.id}"}
                >
                  <span data-copy-idle>{gettext("Copy")}</span>
                  <span data-copy-feedback class="hidden">{gettext("Copied")}</span>
                </button>
                <button type="button" class="link" phx-click="stt_use_text" phx-value-id={result.id}>
                  {gettext("Use as chat message")}
                </button>
              </div>
            </div>
          </div>
        </.form_section>
      <% end %>

      <%!-- Response Area. The hook owns the `phx:scroll-into-view` listener
           for every card below: each dispatches the event on itself via
           `phx-mounted`, and it bubbles up to this container. --%>
      <div id="playground-response" class="space-y-6" phx-hook="PhoenixKitAIScrollIntoView">
        <%!-- Loading Skeleton --%>
        <%= if @sending do %>
          <div
            id="playground-skeleton"
            class="card bg-base-200 animate-pulse"
            phx-mounted={JS.dispatch("phx:scroll-into-view", to: "#playground-skeleton")}
          >
            <div class="card-body">
              <div class="flex items-center gap-2 mb-3">
                <span class="loading loading-spinner loading-sm text-primary"></span>
                <span class="text-sm text-base-content/60">{gettext("Waiting for response...")}</span>
              </div>
              <div class="space-y-3">
                <div class="bg-base-300 rounded h-4 w-3/4"></div>
                <div class="bg-base-300 rounded h-4 w-full"></div>
                <div class="bg-base-300 rounded h-4 w-5/6"></div>
                <div class="bg-base-300 rounded h-4 w-2/3"></div>
              </div>
            </div>
          </div>
        <% end %>

        <%!-- Error Display --%>
        <%= if @response_error do %>
          <div
            id="playground-error"
            class="alert alert-error"
            phx-mounted={JS.dispatch("phx:scroll-into-view", to: "#playground-error")}
          >
            <.icon name="hero-exclamation-triangle" class="w-5 h-5" />
            <div>
              <div class="font-medium">{gettext("Error")}</div>
              <div class="text-sm">{@response_error}</div>
            </div>
          </div>
        <% end %>

        <%!-- Response Card --%>
        <%= if @response_text do %>
          <.form_section
            title={gettext("Response")}
            icon="hero-sparkles"
            class="bg-base-200"
            id="playground-result"
            phx-mounted={JS.dispatch("phx:scroll-into-view", to: "#playground-result")}
          >
            <%!-- Usage Stats --%>
            <%= if @response_usage do %>
              <div class="flex flex-wrap gap-3 text-xs text-base-content/60">
                <span>
                  <.icon name="hero-arrow-up" class="w-3 h-3 inline" />
                  {PhoenixKitAI.Request.format_tokens(@response_usage.prompt_tokens)} {gettext("in")}
                </span>
                <span>
                  <.icon name="hero-arrow-down" class="w-3 h-3 inline" />
                  {PhoenixKitAI.Request.format_tokens(
                    @response_usage.completion_tokens
                  )} {gettext("out")}
                </span>
                <span>
                  <.icon name="hero-calculator" class="w-3 h-3 inline" />
                  {PhoenixKitAI.Request.format_tokens(@response_usage.total_tokens)} {gettext("total")}
                </span>
                <%= if @response_usage.cost do %>
                  <span>
                    <.icon name="hero-currency-dollar" class="w-3 h-3 inline" />
                    {PhoenixKitAI.Request.format_cost(@response_usage.cost)}
                  </span>
                <% end %>
              </div>
            <% end %>

            <%!-- Response Content --%>
            <div class="bg-base-300 rounded-lg p-4 mt-2 text-sm">
              <pre class="whitespace-pre-wrap font-[inherit] m-0">{@response_text}</pre>
            </div>
          </.form_section>
        <% end %>
      </div>
    </div>
  </div>
